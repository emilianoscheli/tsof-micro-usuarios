  "ServiceBus": {
    "ConnectionStrings": "",
    "TopicsToListen": [
      {
        "TopicName": "automatismos-topic",
        "SubscriptionName": "usuarios-MS"
      }
    ],
    "EnableSetup": true
  },
  "LogRetentionMonths": 1,
  "Serilog": {

    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UsuariosCache": {
    "DurationMinutes": 5
  }
